<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeAlta.Hosting\CodeAlta.Hosting.csproj" />
    <ProjectReference Include="..\CodeAlta.Tests.CursorCli\CodeAlta.Tests.CursorCli.csproj" />
    <ProjectReference Include="..\CodeAlta.Tests.GrokCli\CodeAlta.Tests.GrokCli.csproj" />
  </ItemGroup>

  <Target Name="CopyCursorCliHost" AfterTargets="Build">
    <ItemGroup>
      <CursorCliHost Include="..\CodeAlta.Tests.CursorCli\bin\$(Configuration)\net10.0\CodeAlta.Tests.CursorCli.runtimeconfig.json" />
      <CursorCliHost Include="..\CodeAlta.Tests.CursorCli\bin\$(Configuration)\net10.0\CodeAlta.Tests.CursorCli.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(CursorCliHost)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyGrokCliHost" AfterTargets="Build">
    <ItemGroup>
      <GrokCliHost Include="..\CodeAlta.Tests.GrokCli\bin\$(Configuration)\net10.0\CodeAlta.Tests.GrokCli.runtimeconfig.json" />
      <GrokCliHost Include="..\CodeAlta.Tests.GrokCli\bin\$(Configuration)\net10.0\CodeAlta.Tests.GrokCli.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(GrokCliHost)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
